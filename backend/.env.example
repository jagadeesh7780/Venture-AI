# ==========================================
# FastAPI & Database Environment Variables
# ==========================================

# Application Settings
PROJECT_NAME="AI Business Digital Twin"
API_V1_STR="/api"
ENVIRONMENT=development

# Security & Authentication (JWT & Argon2)
# Generate a strong key in production using: openssl rand -hex 32
JWT_SECRET=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database Configuration
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aibusiness_db

# Complete Database Connection URL (Override if using cloud PostgreSQL like Supabase or Neon)
DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/aibusiness_db

# Local Open-Source LLM Configuration (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
LLM_TIMEOUT_SECONDS=90

# Google Maps API Key
GOOGLE_MAPS_API_KEY=AIzaSyAtc6KyR6cnnSjvf4o_zcNfzcWZF0ob0Vo

# CORS Allowed Origins (Comma-separated or JSON list for frontend URLs)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
